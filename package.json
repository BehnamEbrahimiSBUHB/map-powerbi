{
  "name": "map-powerbi",
  "version": "0.1.0",
  "description": "Power BI shape map files (TopoJSON) for Swansea and Neath Port Talbot, built from ONS boundaries",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:refresh": "bun run scripts/build.ts --refresh",
    "build:rehex": "bun run scripts/build.ts --rehex",
    "data": "bun run scripts/synthetic.ts",
    "wimd": "bun run scripts/wimd.ts",
    "catalogue": "bun run scripts/catalogue.ts",
    "check": "bun run scripts/check.ts",
    "typecheck": "tsc --noEmit",
    "site:build": "bun run scripts/site.ts",
    "site:serve": "bun run scripts/site.ts --serve"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "mapshaper": "^0.7.101",
    "typescript": "^7.0.2"
  }
}
